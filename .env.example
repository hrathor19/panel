# ── Required ───────────────────────────────────────────────────────────
# openssl rand -hex 32
# Signs sessions AND encrypts stored panel passwords. Changing it signs
# everyone out and makes saved panel passwords unreadable (re-enter them).
SESSION_SECRET=

# ── Gateway ────────────────────────────────────────────────────────────
PORT=8080
SESSION_HOURS=12
# Set to 1 behind nginx/Caddy so real client IPs reach the audit log and
# cookies are marked Secure. Vercel sets this automatically.
TRUST_PROXY=0

# ── Storage ────────────────────────────────────────────────────────────
# Leave both blank to keep users, panels and sessions in ./data (a VPS or
# your laptop). Set them to run on a serverless host, where the filesystem
# is read-only and no two requests share memory.
# Vercel KV fills these in for you when you attach a KV store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash direct, if you are not using Vercel KV:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── First administrator ────────────────────────────────────────────────
# Used only when no users exist yet. Set ADMIN_PASSWORD on a hosted deploy;
# otherwise one is generated and printed to the logs.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── First panel (optional) ─────────────────────────────────────────────
# Seeds one panel on first boot so the admin UI is not empty. Ignored after.
NPF_LABEL=NPF
NPF_URL=https://publisher.nopaperforms.com
NPF_EMAIL=
NPF_PASSWORD=

# ── Leak controls ──────────────────────────────────────────────────────
# Watermark text. Appears tiled across every panel page, with the viewer's
# email and the time, so any screenshot identifies who took it.
BRAND=KollegeApply
# all | users | off   — 'all' also watermarks admins (attribution is free);
# 'users' leaves admins a clean view for debugging.
WATERMARK_MODE=all
# How strong the mark is. 0.12 is the faintest that still identifies a leaker
# after a screenshot is compressed; 0.30 starts obscuring phone numbers.
WATERMARK_OPACITY=0.17
# Set to 0 to allow copy/selection/right-click for role=user.
DISABLE_COPY=1
# Lead-listing requests allowed per user per window, for users WITHOUT export
# permission. This is the one control a browser cannot bypass. Humans read a
# few pages an hour; a scraper reads hundreds.
BULK_MAX_PER_WINDOW=300
BULK_WINDOW_MINUTES=60

# ── Tuning (optional) ──────────────────────────────────────────────────
# LOGIN_MAX_PER_ACCOUNT=8
# LOGIN_MAX_PER_IP=40
# LOGIN_WINDOW_MINUTES=15
# DOC_CACHE_MS=3000
